Yêu cầu của bạn vô cùng tuyệt vời và đánh trúng vào hai yếu tố cốt lõi của một trang web nội thất cao cấp: **Tốc độ tải ảnh thực tế** và **tính cơ động của nội dung**.

Hệ thống tải ảnh nguyên bản qua URL hoặc dán link Google Drive thủ công rất dễ gặp lỗi do sai định dạng, đồng thời ảnh gốc tải lên thường có dung lượng quá nặng (từ 2MB - 10MB) làm trang web tải chậm khủng khiếp.

---

### GIẢI PHÁP NÂNG CẤP TOÀN DIỆN:
1. **Bộ nén & Tự động Crop ảnh thông minh trên Trình duyệt (HTML5 Canvas Engine):**
   * Trong trang Admin, thay vì dán link thủ công, bạn sẽ chọn tệp ảnh trực tiếp từ máy tính/điện thoại.
   * Hệ thống sẽ tự động phân tích tỷ lệ ảnh:
     * **Ảnh ngang (Landscape):** Tự động crop căn giữa về tỷ lệ **3:2** chuẩn mỹ thuật (1200px x 800px).
     * **Ảnh dọc (Portrait):** Tự động crop về tỷ lệ **2:3** chuẩn kiến trúc (800px x 1200px).
     * **Ảnh vuông (Square):** Tự động crop về tỷ lệ **1:1** (1000px x 1000px).
   * Ảnh sau đó được nén tự động về định dạng `.jpg` chất lượng cao (85%) giúp giảm dung lượng từ vài MB xuống **chỉ còn khoảng ~150KB** mà mắt thường không thể thấy sự suy giảm độ sắc nét. Website của bạn sẽ tải nhanh như bay.
   * Ảnh nén xong được tự động tải thẳng lên **Google Drive** của bạn thông qua Apps Script và lưu trực tiếp link ảnh sạch vào Sheet.
2. **Quản lý Đánh Giá Khách Hàng động (Thêm/Sửa/Xóa Đánh Giá):**
   * Chuyển đổi toàn bộ phần đánh giá khách hàng trên trang chủ sang chế độ đọc động từ tab Sheet tên là `reviews`.
   * Bổ sung một tab quản lý đánh giá khách hàng chuyên biệt trên trang Admin giúp bạn dễ dàng Thêm, Sửa, Xóa các phản hồi thực tế của khách hàng.
3. **Bổ sung ảnh Header mờ ảo sang trọng:**
   * Tích hợp thêm khóa `hero_bg` (Ảnh nền Header) vào hệ thống. Bạn có thể chọn tải trực tiếp ảnh nội thất làm nền cho phần đầu trang, kết hợp hiệu ứng mờ và lưới grid bóng bẩy của bản gốc.

---

### MỤC 1: CẬP NHẬT MÃ BACKEND GOOGLE APPS SCRIPT (`Code.gs`)
Bạn hãy mở Google Sheets > **Tiện ích mở rộng (Extensions)** > **Apps Script**, xóa toàn bộ code cũ trong file `Code.gs` và dán mã mới tích hợp xử lý tải tệp trực tiếp và Đánh Giá dưới đây, sau đó bấm **Triển khai (Deploy)** phiên bản mới:

```javascript
// Code.gs - Apps Script Web App Backend
function doGet(e) {
  var type = e.parameter.type;
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  
  // 1. LẤY DỮ LIỆU CÔNG TRÌNH (GALLERY)
  if (!type) {
    var sheet = ss.getSheetByName('gallery') || ss.insertSheet('gallery');
    if (sheet.getLastRow() === 0) {
      sheet.appendRow(['id', 'title', 'category', 'location', 'size', 'image']);
    }
    var data = sheet.getDataRange().getValues();
    var items = [];
    for (var i = 1; i < data.length; i++) {
      items.push({
        id: data[i][0],
        title: data[i][1],
        category: data[i][2],
        location: data[i][3],
        size: data[i][4],
        image: data[i][5]
      });
    }
    return resJSON({ items: items.reverse() });
  }
  
  // 2. LẤY DỮ LIỆU TEXT NỘI DUNG (CONTENT)
  if (type === 'content') {
    var sheet = ss.getSheetByName('content') || ss.insertSheet('content');
    if (sheet.getLastRow() === 0) {
      sheet.appendRow(['key', 'value']);
    }
    var data = sheet.getDataRange().getValues();
    var content = [];
    for (var i = 1; i < data.length; i++) {
      content.push({ key: data[i][0], value: data[i][1] });
    }
    return resJSON({ content: content });
  }
  
  // 3. LẤY DANH SÁCH LIÊN HỆ KHÁCH HÀNG (CONTACTS)
  if (type === 'contacts') {
    var sheet = ss.getSheetByName('contacts') || ss.insertSheet('contacts');
    if (sheet.getLastRow() === 0) {
      sheet.appendRow(['Thời Gian', 'Họ Tên', 'SĐT', 'Email', 'Dịch Vụ', 'Diện Tích', 'Địa Điểm', 'Ghi Chú']);
    }
    var rawData = sheet.getDataRange().getValues();
    var contacts = [];
    for (var i = 1; i < rawData.length; i++) {
      var row = rawData[i];
      var formattedDate = row[0] instanceof Date ? Utilities.formatDate(row[0], Session.getScriptTimeZone(), "yyyy-MM-dd HH:mm") : row[0];
      contacts.push([formattedDate, row[1], row[2], row[3], row[4], row[5], row[6], row[7]]);
    }
    return resJSON({ contacts: contacts.reverse(), sheetUrl: ss.getUrl() });
  }

  // 4. LẤY DANH SÁCH ĐÁNH GIÁ (REVIEWS)
  if (type === 'reviews') {
    var sheet = ss.getSheetByName('reviews') || ss.insertSheet('reviews');
    if (sheet.getLastRow() === 0) {
      sheet.appendRow(['id', 'name', 'role', 'text', 'proj', 'stars']);
    }
    var data = sheet.getDataRange().getValues();
    var reviews = [];
    for (var i = 1; i < data.length; i++) {
      reviews.push({
        id: data[i][0],
        name: data[i][1],
        role: data[i][2],
        text: data[i][3],
        proj: data[i][4],
        stars: data[i][5]
      });
    }
    return resJSON({ reviews: reviews.reverse() });
  }
}

function doPost(e) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var postData = JSON.parse(e.postData.contents);
  var type = postData.type;

  // 1. TẢI ẢNH TRỰC TIẾP LÊN GOOGLE DRIVE
  if (type === 'upload_image') {
    try {
      var folder;
      var folders = DriveApp.getFoldersByName("ThachPro_Images");
      if (folders.hasNext()) {
        folder = folders.next();
      } else {
        folder = DriveApp.createFolder("ThachPro_Images");
      }
      
      var decoded = Utilities.base64Decode(postData.base64);
      var blob = Utilities.newBlob(decoded, postData.contentType, postData.filename);
      var file = folder.createFile(blob);
      file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
      
      var directUrl = "https://drive.google.com/uc?export=view&id=" + file.getId();
      return resJSON({ success: true, url: directUrl });
    } catch (err) {
      return resJSON({ success: false, error: err.toString() });
    }
  }

  // 2. LƯU LIÊN HỆ KHÁCH HÀNG (CONTACT)
  if (type === 'contact') {
    var sheet = ss.getSheetByName('contacts') || ss.insertSheet('contacts');
    sheet.appendRow([
      new Date(),
      postData.name,
      "'" + postData.phone,
      postData.email,
      postData.service,
      postData.area,
      postData.address,
      postData.note
    ]);
    return ContentService.createTextOutput("SUCCESS");
  }

  // 3. LƯU CÔNG TRÌNH (GALLERY_SAVE)
  if (type === 'gallery_save') {
    var sheet = ss.getSheetByName('gallery') || ss.insertSheet('gallery');
    var data = sheet.getDataRange().getValues();
    var id = postData.id;
    var rowIdx = -1;
    for (var i = 1; i < data.length; i++) {
      if (data[i][0] == id) { rowIdx = i + 1; break; }
    }
    var rowData = [id, postData.title, postData.category, postData.location, postData.size, postData.image];
    if (rowIdx > 0) {
      sheet.getRange(rowIdx, 1, 1, 6).setValues([rowData]);
    } else {
      sheet.appendRow(rowData);
    }
    return ContentService.createTextOutput("SUCCESS");
  }

  // 4. XÓA CÔNG TRÌNH (GALLERY_DELETE)
  if (type === 'gallery_delete') {
    var sheet = ss.getSheetByName('gallery') || ss.insertSheet('gallery');
    var data = sheet.getDataRange().getValues();
    for (var i = 1; i < data.length; i++) {
      if (data[i][0] == postData.id) {
        sheet.deleteRow(i + 1);
        break;
      }
    }
    return ContentService.createTextOutput("SUCCESS");
  }

  // 5. LƯU NỘI DUNG TEXT CHỈNH SỬA (CONTENT_SAVE)
  if (type === 'content_save') {
    var sheet = ss.getSheetByName('content') || ss.insertSheet('content');
    sheet.clearContents();
    sheet.appendRow(['key', 'value']);
    var list = postData.content;
    for (var i = 0; i < list.length; i++) {
      sheet.appendRow([list[i].key, list[i].value]);
    }
    return ContentService.createTextOutput("SUCCESS");
  }

  // 6. LƯU ĐÁNH GIÁ KHÁCH HÀNG (REVIEW_SAVE)
  if (type === 'review_save') {
    var sheet = ss.getSheetByName('reviews') || ss.insertSheet('reviews');
    var data = sheet.getDataRange().getValues();
    var id = postData.id;
    var rowIdx = -1;
    for (var i = 1; i < data.length; i++) {
      if (data[i][0] == id) { rowIdx = i + 1; break; }
    }
    var rowData = [id, postData.name, postData.role, postData.text, postData.proj, postData.stars];
    if (rowIdx > 0) {
      sheet.getRange(rowIdx, 1, 1, 6).setValues([rowData]);
    } else {
      sheet.appendRow(rowData);
    }
    return ContentService.createTextOutput("SUCCESS");
  }

  // 7. XÓA ĐÁNH GIÁ KHÁCH HÀNG (REVIEW_DELETE)
  if (type === 'review_delete') {
    var sheet = ss.getSheetByName('reviews') || ss.insertSheet('reviews');
    var data = sheet.getDataRange().getValues();
    for (var i = 1; i < data.length; i++) {
      if (data[i][0] == postData.id) {
        sheet.deleteRow(i + 1);
        break;
      }
    }
    return ContentService.createTextOutput("SUCCESS");
  }
}

function resJSON(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj))
                       .setMimeType(ContentService.MimeType.JSON);
}
```

