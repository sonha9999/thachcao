            <p dangerouslySetInnerHTML={{ __html: content.footer_desc || 'Đơn vị thi công thạch cao và cung cấp vật liệu xây dựng chuyên nghiệp tại TP.HCM từ năm 2008.' }}></p>
            <div className="social-row">
