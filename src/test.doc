          <a href={`https://zalo.me/${content.contact_phone || '0901234567'}`} target="_blank" rel="noopener noreferrer" className="zalo-btn" title="Chat Zalo">
            <span style={{ background: 'white', color: '#0068FF', width: '22px', height: '22px', borderRadius: '50%', display: 'flex', alignItems: 'center', justifyContent: 'center', fontSize: '0.75rem', fontWeight: '900', flexShrink: 0 }}>Z</span>
            Chat Zalo
          </a>
        </div>
